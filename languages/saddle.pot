msgstr ""

#: includes/abilities/core-content.php:232
msgid "Get post"
msgstr ""

#: includes/abilities/core-content.php:233
msgid "Returns a single post in full: title, content, excerpt, status, slug, author, dates, categories, tags, featured image, discussion settings, and custom fields (meta). Read-only. For an item of a custom content type, pass its post_type."
msgstr ""

